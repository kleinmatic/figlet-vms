# DESCRIP.MMS - OpenVMS Alpha MMS/MMK description file for FIGlet 2.2.5
#
# Usage:
#   $ MMS                        ! Build FIGLET.EXE (with TLF_FONTS) and CHKFONT.EXE
#   $ MMS /MACRO=NOTLF=1         ! Build without TLF_FONTS (for older VMS without <wctype.h>)
#   $ MMS /MACRO=DEBUG=1         ! Build with debugger symbols, no optimization
#   $ MMS CLEAN                  ! Remove object and executable files
#
# Targets HP C / Compaq C / VSI C on OpenVMS Alpha (MMS or MMK).
# FIGLET.EXE finds its fonts in [.FONTS] below the directory of the image.
# The FIGLET_FONTS logical name or the /DIRECTORY qualifier changes this.

CC = CC
LINK = LINK

.IFDEF NOTLF
DEFS =
FIGLET_OBJS = FIGLET.OBJ,FIGLET_CLD.OBJ,ZIPIO.OBJ,CRC.OBJ,INFLATE.OBJ
.ELSE
DEFS = /DEFINE=(TLF_FONTS=1)
FIGLET_OBJS = FIGLET.OBJ,FIGLET_CLD.OBJ,ZIPIO.OBJ,CRC.OBJ,INFLATE.OBJ,UTF8.OBJ
.ENDIF

.IFDEF DEBUG
OPTFLAGS = /DEBUG/NOOPTIMIZE
LFLAGS = /DEBUG
.ELSE
OPTFLAGS = /OPTIMIZE
LFLAGS =
.ENDIF

CFLAGS = /PREFIX=ALL $(OPTFLAGS) $(DEFS)

ALL : FIGLET.EXE, CHKFONT.EXE
	@ WRITE SYS$OUTPUT "FIGlet OpenVMS Alpha build complete."

FIGLET.EXE : $(FIGLET_OBJS)
	$(LINK) $(LFLAGS) /EXECUTABLE=FIGLET.EXE $(FIGLET_OBJS)

CHKFONT.EXE : CHKFONT.OBJ
	$(LINK) $(LFLAGS) /EXECUTABLE=CHKFONT.EXE CHKFONT.OBJ

FIGLET.OBJ : FIGLET.C, ZIPIO.H, UTF8.H
	$(CC) $(CFLAGS) /OBJECT=FIGLET.OBJ FIGLET.C

FIGLET_CLD.OBJ : FIGLET_CLD.CLD
	SET COMMAND/OBJECT=FIGLET_CLD.OBJ FIGLET_CLD.CLD

ZIPIO.OBJ : ZIPIO.C, ZIPIO.H, INFLATE.H, CRC.H
	$(CC) $(CFLAGS) /OBJECT=ZIPIO.OBJ ZIPIO.C

CRC.OBJ : CRC.C, CRC.H
	$(CC) $(CFLAGS) /OBJECT=CRC.OBJ CRC.C

INFLATE.OBJ : INFLATE.C, INFLATE.H
	$(CC) $(CFLAGS) /OBJECT=INFLATE.OBJ INFLATE.C

UTF8.OBJ : UTF8.C, UTF8.H
	$(CC) $(CFLAGS) /OBJECT=UTF8.OBJ UTF8.C

CHKFONT.OBJ : CHKFONT.C
	$(CC) $(CFLAGS) /OBJECT=CHKFONT.OBJ CHKFONT.C

CLEAN :
	- IF F$SEARCH("*.OBJ") .NES. "" THEN DELETE/NOLOG *.OBJ;*
	- IF F$SEARCH("FIGLET.EXE") .NES. "" THEN DELETE/NOLOG FIGLET.EXE;*
	- IF F$SEARCH("CHKFONT.EXE") .NES. "" THEN DELETE/NOLOG CHKFONT.EXE;*
