!
! FIGLET_CLD.CLD - DCL command table for FIGlet on OpenVMS
!
! BUILD_VMS.COM and DESCRIP.MMS compile this file with
!     $ SET COMMAND/OBJECT=FIGLET_CLD.OBJ FIGLET_CLD.CLD
! and link the object module into FIGLET.EXE.  FIGLET.C gives the
! table to CLI$DCL_PARSE.  Do not use SET COMMAND to add this file to
! the process command table: it has no IMAGE clause.
!
! The first four characters of each qualifier name must be unique.
!
MODULE FIGLET_CLD

DEFINE TYPE JUSTIFY_KEYWORDS
    KEYWORD LEFT
    KEYWORD CENTER
    KEYWORD RIGHT

DEFINE TYPE SPACING_KEYWORDS
    KEYWORD SMUSH
    KEYWORD KERN
    KEYWORD FULL_WIDTH
    KEYWORD OVERLAP

DEFINE VERB FIGLET
    PARAMETER P1
    PARAMETER P2
    PARAMETER P3
    PARAMETER P4
    PARAMETER P5
    PARAMETER P6
    PARAMETER P7
    PARAMETER P8
    QUALIFIER FONT, NONNEGATABLE, VALUE(REQUIRED)
    QUALIFIER DIRECTORY, NONNEGATABLE, VALUE(REQUIRED)
    QUALIFIER CONTROL, NONNEGATABLE, VALUE(REQUIRED, LIST)
    QUALIFIER WIDTH, NONNEGATABLE, VALUE(REQUIRED)
    QUALIFIER TERMINAL, NONNEGATABLE
    QUALIFIER JUSTIFY, NONNEGATABLE, VALUE(REQUIRED, TYPE=JUSTIFY_KEYWORDS)
    QUALIFIER RIGHT_TO_LEFT, NEGATABLE
    QUALIFIER PARAGRAPH, NONNEGATABLE
    QUALIFIER GERMAN, NONNEGATABLE
    QUALIFIER SPACING, NONNEGATABLE, VALUE(REQUIRED, TYPE=SPACING_KEYWORDS)
    QUALIFIER SMUSH_MODE, NONNEGATABLE, VALUE(REQUIRED)
    QUALIFIER INPUT, NONNEGATABLE, VALUE(REQUIRED, TYPE=$FILE)
    QUALIFIER OUTPUT, NONNEGATABLE, VALUE(REQUIRED, TYPE=$FILE)
    QUALIFIER LIST, NONNEGATABLE
    QUALIFIER SAMPLES, NONNEGATABLE
    QUALIFIER VERSION, NONNEGATABLE
    QUALIFIER INFO, NONNEGATABLE, VALUE(REQUIRED)
    DISALLOW ANY2(SPACING, SMUSH_MODE)
    DISALLOW ANY2(WIDTH, TERMINAL)
    DISALLOW ANY2(LIST, SAMPLES, VERSION, INFO)
