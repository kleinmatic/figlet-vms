$! BUILD_VMS.COM - Standalone OpenVMS Alpha DCL build script for FIGlet 2.2.5
$!
$! Usage:
$!   $ @BUILD_VMS            ! Build FIGLET.EXE (with TLF_FONTS) and CHKFONT.EXE
$!   $ @BUILD_VMS NOTLF      ! Build without TLF_FONTS
$!   $ @BUILD_VMS DEBUG      ! Build with /DEBUG/NOOPTIMIZE
$!   $ @BUILD_VMS CLEAN      ! Remove .OBJ and .EXE build artifacts
$!
$! Options NOTLF and DEBUG may be combined in any order.
$!
$ SAVE_VERIFY = 'F$VERIFY(0)'
$ ON ERROR THEN GOTO ERR_EXIT
$ ON CONTROL_Y THEN GOTO ERR_EXIT
$!
$ ORIG_DIR = F$ENVIRONMENT("DEFAULT")
$ PROC_FILE = F$ENVIRONMENT("PROCEDURE")
$ SRC_DIR = F$PARSE(PROC_FILE, , , "DEVICE") + F$PARSE(PROC_FILE, , , "DIRECTORY")
$ SET DEFAULT 'SRC_DIR'
$!
$ DO_CLEAN = 0
$ DO_DEBUG = 0
$ DO_TLF = 1
$!
$ I = 1
$ PARSE_LOOP:
$   IF I .GT. 8 THEN GOTO PARSE_DONE
$   ARG = F$EDIT(P'I', "UPCASE,TRIM")
$   IF ARG .EQS. "" THEN GOTO PARSE_NEXT
$   IF ARG .EQS. "CLEAN" THEN GOTO SET_CLEAN
$   IF ARG .EQS. "DEBUG" THEN GOTO SET_DEBUG
$   IF ARG .EQS. "NOTLF" THEN GOTO SET_NOTLF
$   WRITE SYS$OUTPUT "Unknown option: ", ARG
$   WRITE SYS$OUTPUT "Usage: @BUILD_VMS [NOTLF] [DEBUG] [CLEAN]"
$   GOTO ERR_EXIT
$ SET_CLEAN:
$   DO_CLEAN = 1
$   GOTO PARSE_NEXT
$ SET_DEBUG:
$   DO_DEBUG = 1
$   GOTO PARSE_NEXT
$ SET_NOTLF:
$   DO_TLF = 0
$ PARSE_NEXT:
$   I = I + 1
$   GOTO PARSE_LOOP
$ PARSE_DONE:
$!
$ IF DO_CLEAN THEN GOTO DO_CLEAN_BUILD
$!
$ OPTFLAGS = "/OPTIMIZE"
$ LFLAGS = ""
$ IF DO_DEBUG THEN OPTFLAGS = "/DEBUG/NOOPTIMIZE"
$ IF DO_DEBUG THEN LFLAGS = "/DEBUG"
$!
$ DEFS = "/DEFINE=(TLF_FONTS=1)"
$ FIGLET_OBJS = "FIGLET.OBJ,FIGLET_CLD.OBJ,ZIPIO.OBJ,CRC.OBJ,INFLATE.OBJ,UTF8.OBJ"
$ IF .NOT. DO_TLF THEN DEFS = ""
$ IF .NOT. DO_TLF THEN FIGLET_OBJS = "FIGLET.OBJ,FIGLET_CLD.OBJ,ZIPIO.OBJ,CRC.OBJ,INFLATE.OBJ"
$!
$ CFLAGS = "/PREFIX=ALL" + OPTFLAGS + DEFS
$!
$ WRITE SYS$OUTPUT "Building FIGlet for OpenVMS Alpha..."
$ WRITE SYS$OUTPUT "  CC flags: ", CFLAGS
$!
$ WRITE SYS$OUTPUT "Compiling FIGLET.C..."
$ CC 'CFLAGS' /OBJECT=FIGLET.OBJ FIGLET.C
$ WRITE SYS$OUTPUT "Compiling command table FIGLET_CLD.CLD..."
$ SET COMMAND/OBJECT=FIGLET_CLD.OBJ FIGLET_CLD.CLD
$ WRITE SYS$OUTPUT "Compiling ZIPIO.C..."
$ CC 'CFLAGS' /OBJECT=ZIPIO.OBJ ZIPIO.C
$ WRITE SYS$OUTPUT "Compiling CRC.C..."
$ CC 'CFLAGS' /OBJECT=CRC.OBJ CRC.C
$ WRITE SYS$OUTPUT "Compiling INFLATE.C..."
$ CC 'CFLAGS' /OBJECT=INFLATE.OBJ INFLATE.C
$ IF .NOT. DO_TLF THEN GOTO SKIP_UTF8
$ WRITE SYS$OUTPUT "Compiling UTF8.C..."
$ CC 'CFLAGS' /OBJECT=UTF8.OBJ UTF8.C
$ SKIP_UTF8:
$ WRITE SYS$OUTPUT "Compiling CHKFONT.C..."
$ CC 'CFLAGS' /OBJECT=CHKFONT.OBJ CHKFONT.C
$!
$ WRITE SYS$OUTPUT "Linking FIGLET.EXE..."
$ LINK 'LFLAGS' /EXECUTABLE=FIGLET.EXE 'FIGLET_OBJS'
$ WRITE SYS$OUTPUT "Linking CHKFONT.EXE..."
$ LINK 'LFLAGS' /EXECUTABLE=CHKFONT.EXE CHKFONT.OBJ
$!
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Build succeeded: FIGLET.EXE and CHKFONT.EXE created in ", SRC_DIR
$ WRITE SYS$OUTPUT "To run it:  MCR ", SRC_DIR, "FIGLET ""Hello"""
$ WRITE SYS$OUTPUT "or define:  FIGLET :== $", SRC_DIR, "FIGLET.EXE"
$ GOTO OK_EXIT
$!
$ DO_CLEAN_BUILD:
$ WRITE SYS$OUTPUT "Cleaning FIGlet build artifacts..."
$ IF F$SEARCH("*.OBJ") .NES. "" THEN DELETE/NOLOG *.OBJ;*
$ IF F$SEARCH("FIGLET.EXE") .NES. "" THEN DELETE/NOLOG FIGLET.EXE;*
$ IF F$SEARCH("CHKFONT.EXE") .NES. "" THEN DELETE/NOLOG CHKFONT.EXE;*
$ WRITE SYS$OUTPUT "Clean complete."
$!
$ OK_EXIT:
$   SET DEFAULT 'ORIG_DIR'
$   EXIT 1 + 0 * F$VERIFY(SAVE_VERIFY)
$!
$ ERR_EXIT:
$   SAV_STATUS = $STATUS
$   SET DEFAULT 'ORIG_DIR'
$   IF SAV_STATUS THEN SAV_STATUS = %X10000002
$   EXIT SAV_STATUS + 0 * F$VERIFY(SAVE_VERIFY)
